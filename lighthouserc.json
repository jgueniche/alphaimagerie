{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start --port 3210",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://127.0.0.1:3210/",
        "http://127.0.0.1:3210/examens/irm",
        "http://127.0.0.1:3210/examens/irm/genou",
        "http://127.0.0.1:3210/centres/cergy",
        "http://127.0.0.1:3210/centres/cergy/irm",
        "http://127.0.0.1:3210/preparer-mon-examen/irm",
        "http://127.0.0.1:3210/contact"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": { "mobile": true, "width": 412, "height": 823, "deviceScaleFactor": 1.75 }
      }
    },
    "assert": {
      "_commentaire": "Perf en warn en CI : `next start` sur runner partagé (sans compression CDN, démarrage à froid) sous-évalue les scores — le seuil §13 (≥95 mobile) reste bloquant à la checklist de mise en production, mesuré sur l'hébergement réel (PSI, docs/benchmark/psi_fetch.sh). Les catégories déterministes restent bloquantes en CI.",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
